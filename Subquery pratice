-- SUBQUERY QUESTIONS
-- =========================================


-- Q1. Average salary se zyada salary wale employees find karo.

SELECT *
FROM employees
WHERE salary > (
    SELECT AVG(salary)
    FROM employees
);


-- Q2. Sabse zyada salary lene wale employee ko find karo.

SELECT *
FROM employees
WHERE salary = (
    SELECT MAX(salary)
    FROM employees
);


-- Q3. Sabse kam salary lene wale employee ko find karo.

SELECT *
FROM employees
WHERE salary = (
    SELECT MIN(salary)
    FROM employees
);


-- Q4. IT department ki average salary se zyada salary wale
-- employees find karo.

SELECT *
FROM employees
WHERE salary > (
    SELECT AVG(salary)
    FROM employees
    WHERE department = 'IT'
);


-- Q5. Amit se zyada salary lene wale employees find karo.

SELECT *
FROM employees
WHERE salary > (
    SELECT salary
    FROM employees
    WHERE emp_name = 'Amit'
);


-- Q6. IT department ke sabhi employees se zyada salary
-- wale employees find karo.

SELECT *
FROM employees
WHERE salary > ALL (
    SELECT salary
    FROM employees
    WHERE department = 'IT'
);


-- Q7. Finance ya HR department me kaam karne wale
-- employees find karo.

SELECT *
FROM employees
WHERE department IN (
    SELECT department
    FROM employees
    WHERE department IN ('Finance', 'HR')
);


-- Q8. Apne department ki average salary se zyada salary
-- wale employees find karo.

SELECT e.*
FROM employees e
WHERE e.salary > (
    SELECT AVG(e2.salary)
    FROM employees e2
    WHERE e2.department = e.department
);


-- Q9. Jinke paas koi project assigned hai un employees
-- ko find karo.

SELECT *
FROM employees e
WHERE EXISTS (
    SELECT 1
    FROM projects p
    WHERE p.emp_id = e.emp_id
);


-- Q10. Sabse zyada budget wale project ko find karo.

SELECT *
FROM projects
WHERE budget = (
    SELECT MAX(budget)
    FROM projects
);




